# ============================================
# DC AgentPay X — Environment Variables
# ============================================

# MongoDB (Atlas recommended)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/dc-agentpay-x?retryWrites=true&w=majority
MONGODB_DB_NAME=dc_agentpay_x

# Auth — Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Auth — JWT
JWT_SECRET=your-jwt-secret-min-32-chars-change-in-production

# HTX API (Testnet by default)
HTX_API_KEY=your-htx-testnet-access-key
HTX_API_SECRET=your-htx-testnet-secret-key
HTX_API_BASE=https://api-aws.huobi.pro
HTX_TESTNET=true
HTX_CHAIN_ID=10243

# DeepSeek AI
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_API_URL=https://api.deepseek.com/v1

# App
NEXT_PUBLIC_APP_NAME=DC AgentPay X
NEXT_PUBLIC_DEFAULT_LOCALE=zh-TW
NEXT_PUBLIC_APP_URL=https://dc-agentpay-x.vercel.app

# Mode
DEMO_MODE=true
